{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uncached",
  "version": "0.1.1-alpha.2",
  "identifier": "app.uncached.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Uncached",
        "width": 1080,
        "height": 800,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "minWidth": 800,
        "minHeight": 600,
        "minimizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
