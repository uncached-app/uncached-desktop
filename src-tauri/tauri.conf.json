{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uncached",
  "version": "0.1.1-alpha.2",
  "identifier": "app.uncached.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Uncached",
        "width": 1112,
        "height": 832,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "minWidth": 832,
        "minHeight": 632,
        "minimizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Uncached",
    "homepage": "https://uncached.app",
    "copyright": "Copyright \u00a9 2026 Uncached",
    "license": "Proprietary",
    "category": "DeveloperTool",
    "shortDescription": "Reclaim disk from build artifacts.",
    "longDescription": "Uncached finds the dependency, build and cache directories your toolchains can regenerate, measures what they weigh, and moves the ones you choose to the Recycle Bin. It reads a project before offering it: work that exists only on this disk is never something the app automates.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "section": "devel"
      }
    }
  }
}
