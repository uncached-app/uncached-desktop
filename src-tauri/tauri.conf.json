{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uncached",
  "mainBinaryName": "Uncached",
  "version": "0.2.0",
  "identifier": "app.uncached.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Uncached",
        "width": 1112,
        "height": 832,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "minWidth": 832,
        "minHeight": 632,
        "minimizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Uncached",
    "homepage": "https://uncached.app",
    "copyright": "Copyright © 2026 Uncached",
    "license": "Proprietary",
    "category": "DeveloperTool",
    "shortDescription": "Reclaim disk from build artifacts.",
    "longDescription": "Uncached finds the dependency, build and cache directories your toolchains can regenerate, measures what they weigh, and moves the ones you choose to the Recycle Bin. It reads a project before offering it: work that exists only on this disk is never something the app automates.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "section": "devel"
      }
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwQUE5RjU2M0U1NDhEMQpSV1RSU09Wajlha0tDck1DQTc5WmN3TFQxYXBvTy9ndGZMc1Vmb3lxYUdLdHlWKzdLYmVIcVdtQgo=",
      "endpoints": [
        "https://cdn.uncached.app/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
